<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Must stay false: Microsoft.Data.SqlClient needs real culture data and throws
         "Only the invariant culture is supported in globalization-invariant mode" on
         connect. Invariant mode mainly saves ICU size on Linux containers; this app runs
         on Windows App Service where ICU is present anyway. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <UserSecretsId>eeb92d08-ebad-4094-86a6-24cf86c0cac2</UserSecretsId>
    <!-- wwwroot is generated by the SPA build (see the BuildSpa target below), so the
         static-web-assets pipeline is turned off: it resolves wwwroot at evaluation
         time, which is before Vite rewrites the hashed filenames, and then fails trying
         to publish files that no longer exist. With it off, wwwroot is plain Content
         that the target can re-glob after the build. Runtime is unaffected -
         UseStaticFiles serves from the physical wwwroot in the publish output. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <!-- Keep wwwroot out of the evaluation-time globs entirely.

       Removing it inside the build target was not enough. The SDK turns Content into
       ContentWithTargetPath during AssignTargetPaths, which runs as part of Build - before
       the SPA is rebuilt. Removing the Content items afterwards left those already-derived
       ContentWithTargetPath entries behind, still naming the PREVIOUS build's hashed
       filenames, and the publish then failed with a wall of MSB3030 "could not copy ...
       because it was not found".

       Excluding it here means nothing ever globs wwwroot at evaluation, so there is no stale
       list to contradict the build. StageSpaForPublish adds the real files instead. -->
  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <None Remove="wwwroot\**" />

    <!-- Same reasoning for the prerendered page snapshots: they are generated by
         `npm run prerender` after this project is evaluated, so an evaluation-time glob
         would name whatever existed last time. StagePrerenderedForPublish adds the real
         files instead. -->
    <Content Remove="prerendered\**" />
    <None Remove="prerendered\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.40.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="9.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageReference Include="Microsoft.Identity.Web" Version="3.8.2" />
    <PackageReference Include="SkiaSharp" Version="4.151.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.4" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Properties\launchSettings.json">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- ==== SPA build on publish ==================================================
       Publishing the API also builds the React app, so wwwroot can never ship stale.
       This replaces the old manual "npm run build, then copy dist/ into wwwroot"
       routine: `dotnet publish` (or VS Code's Publish) is now the single action.

       Only runs on publish - `dotnet build`, `dotnet run` and `dotnet test` are
       untouched, so day-to-day work stays fast (local dev uses the Vite dev server
       on :5173 proxying to the API on :5178).
       Set /p:SkipSpaBuild=true to publish without rebuilding the frontend.        -->
  <PropertyGroup>
    <SpaRoot>$(MSBuildProjectDirectory)\..\NVC Claude version\</SpaRoot>
  </PropertyGroup>

  <!-- Rebuilds the frontend. Skipped by /p:SkipSpaBuild=true, and by design that only skips
       the BUILD - staging below still runs, so an API-only publish still ships whatever is
       already in wwwroot rather than shipping a site with no frontend at all. -->
  <Target Name="BuildSpa" BeforeTargets="StageSpaForPublish" Condition="'$(SkipSpaBuild)' != 'true'">
    <Message Importance="high" Text="Building SPA from $(SpaRoot)" />

    <!-- npm ci only when dependencies are missing; it wipes node_modules, so doing it
         every publish would add a slow minute for no benefit. -->
    <Exec Command="npm ci" WorkingDirectory="$(SpaRoot)" Condition="!Exists('$(SpaRoot)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />
  </Target>

  <!-- Globs wwwroot AFTER the SPA build and hands the result straight to the publish
       pipeline. This is the only thing that puts wwwroot into the publish output, which is
       what keeps the file list and the files on disk from ever disagreeing.

       Contributes ResolvedFileToPublish rather than ContentWithTargetPath, and hooks
       ComputeResolvedFilesToPublishList rather than ComputeFilesToPublish. Both matter:
       BeforeTargets runs after the target's DependsOnTargets, so hooking
       ComputeFilesToPublish is already too late - the content list has been turned into
       ResolvedFileToPublish by then, and freshly added ContentWithTargetPath items are
       silently ignored. The publish then succeeds while shipping an API with no site. -->
  <Target Name="StageSpaForPublish" BeforeTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_SpaBuildOutput Include="wwwroot\**" />
      <ResolvedFileToPublish Include="@(_SpaBuildOutput)" RelativePath="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <Error Condition="'@(_SpaBuildOutput)' == ''" Text="wwwroot is empty, so this publish would ship an API with no site. Run 'npm run build' in $(SpaRoot), or drop /p:SkipSpaBuild=true." />

    <Message Importance="high" Text="SPA staged for publish: @(_SpaBuildOutput-&gt;Count()) files." />
  </Target>

  <!-- Ships the prerendered page snapshots (api-dotnet/prerendered/**), which Program.cs
       loads at startup and serves in place of the empty SPA shell.

       Hooked the same way and for the same reason as StageSpaForPublish above: the files
       are written after evaluation, so they have to be contributed as ResolvedFileToPublish
       rather than globbed as Content.

       Deliberately NOT an error when empty, unlike the SPA staging. Prerendering is a
       separate, optional release step (`npm run prerender`, which needs the app running);
       a publish without it should still ship a working site that simply renders
       client-side, exactly as it did before. -->
  <Target Name="StagePrerenderedForPublish" BeforeTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_PrerenderedOutput Include="prerendered\**\*.html" />
      <ResolvedFileToPublish Include="@(_PrerenderedOutput)" RelativePath="prerendered\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <Message Importance="high" Condition="'@(_PrerenderedOutput)' != ''" Text="Prerendered pages staged for publish: @(_PrerenderedOutput-&gt;Count()) files." />
    <Warning Condition="'@(_PrerenderedOutput)' == ''" Text="No prerendered pages found - the site will ship client-rendered only. Run 'npm run prerender' with the app running to include them." />
  </Target>

  <!-- Refuses a publish whose snapshots point at a bundle this build did not produce.

       On 2026-08-18 a publish shipped the previous day's snapshots alongside a freshly
       built SPA. The publish rebuilds the bundle and Vite hashes it by content, so the
       hash moved and every public page's script tag pointed at a file that no longer
       existed - React never booted and the whole site rendered as dead HTML. Nothing
       failed: the build succeeded and the publish succeeded.

       An ERROR, not a warning, and that is the point. The guard above IS a warning ("no
       prerendered pages found") and that is the right severity for it, because shipping
       without snapshots yields a working client-rendered site. This case yields a BROKEN
       one, so it stops the publish.

       Skipped when the SPA build was skipped (-p:SkipSpaBuild=true): wwwroot is then
       whatever was already on disk, and comparing snapshots against it proves nothing. -->
  <Target Name="VerifyPrerenderedFreshness"
          AfterTargets="StagePrerenderedForPublish"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          Condition="'@(_PrerenderedOutput)' != '' And '$(SkipSpaBuild)' != 'true'">
    <Exec Command="node &quot;$(MSBuildProjectDirectory)\..\NVC Claude version\scripts\check-prerender-freshness.mjs&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
