<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Must stay false: Microsoft.Data.SqlClient needs real culture data and throws
         "Only the invariant culture is supported in globalization-invariant mode" on
         connect. Invariant mode mainly saves ICU size on Linux containers; this app runs
         on Windows App Service where ICU is present anyway. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <UserSecretsId>eeb92d08-ebad-4094-86a6-24cf86c0cac2</UserSecretsId>
    <!-- wwwroot is generated by the SPA build (see the BuildSpa target below), so the
         static-web-assets pipeline is turned off: it resolves wwwroot at evaluation
         time, which is before Vite rewrites the hashed filenames, and then fails trying
         to publish files that no longer exist. With it off, wwwroot is plain Content
         that the target can re-glob after the build. Runtime is unaffected -
         UseStaticFiles serves from the physical wwwroot in the publish output. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Properties\launchSettings.json">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- ==== SPA build on publish ==================================================
       Publishing the API also builds the React app, so wwwroot can never ship stale.
       This replaces the old manual "npm run build, then copy dist/ into wwwroot"
       routine: `dotnet publish` (or VS Code's Publish) is now the single action.

       Only runs on publish - `dotnet build`, `dotnet run` and `dotnet test` are
       untouched, so day-to-day work stays fast (local dev uses the Vite dev server
       on :5173 proxying to the API on :5178).
       Set /p:SkipSpaBuild=true to publish without rebuilding the frontend.        -->
  <PropertyGroup>
    <SpaRoot>$(MSBuildProjectDirectory)\..\NVC Claude version\</SpaRoot>
  </PropertyGroup>

  <Target Name="BuildSpa" BeforeTargets="ComputeFilesToPublish" Condition="'$(SkipSpaBuild)' != 'true'">
    <Message Importance="high" Text="Building SPA from $(SpaRoot)" />

    <!-- npm ci only when dependencies are missing; it wipes node_modules, so doing it
         every publish would add a slow minute for no benefit. -->
    <Exec Command="npm ci" WorkingDirectory="$(SpaRoot)" Condition="!Exists('$(SpaRoot)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />

    <!-- Vite emptied wwwroot and wrote freshly hashed filenames, but MSBuild globbed
         wwwroot at *evaluation* time - that list now points at deleted files. Drop it
         and re-glob from what the build actually produced. -->
    <ItemGroup>
      <Content Remove="wwwroot\**" />
      <_SpaBuildOutput Include="wwwroot\**" />
      <ContentWithTargetPath Include="@(_SpaBuildOutput)" TargetPath="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <Message Importance="high" Text="SPA build complete: @(_SpaBuildOutput-&gt;Count()) files staged for publish." />
  </Target>
</Project>
